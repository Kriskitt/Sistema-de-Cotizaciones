# Plantilla de ejemplo. Sustituir solo en un .env LOCAL no versionado.
# No coloques valores reales aquí ni publiques un archivo .env.
DB_SERVER=tu-endpoint-rds.ejemplo.amazonaws.com
DB_PORT=1433
DB_NAME=SistemaCotizaciones
DB_USER=usuario_de_aplicacion
DB_PASSWORD=NO_USAR_ESTE_VALOR_DE_EJEMPLO
DB_SECRET_ARN=
ALLOWED_ORIGIN=http://localhost:4200
AWS_REGION=us-east-1
